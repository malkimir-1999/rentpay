DATABASE_URL=postgresql://rentpay@127.0.0.1:55432/rentpay
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Enable only when the web app is behind a trusted reverse proxy that validates Host/forwarded-host headers.
AUTH_TRUST_HOST=true
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
LOG_LEVEL=info
PORT=4000
NODE_ENV=development
# Required for shared production rate limiting; local development uses process memory.
REDIS_URL=
# Configure these to deliver email outside the development mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required in production; the mailbox that receives public contact/demo enquiries.
CONTACT_EMAIL=
# Configure the actual RentPay receiving details; these are shown only to authorized business billing users.
SUBSCRIPTION_BANK_TRANSFER_INSTRUCTIONS=
SUBSCRIPTION_EASYPAISA_INSTRUCTIONS=
SUBSCRIPTION_JAZZCASH_INSTRUCTIONS=
SEED_ADMIN_EMAIL=admin@rentpay.local
SEED_ADMIN_PASSWORD=local-only-change-me
